  "shell": "dumpsys notification --noredact",
  "match": "RUNNING.*Σ0:10:00"
 },
 "clock-alarm": {
  "shell": "dumpsys alarm",
  "match": "origWhen=\\d{4}-\\d\\d-\\d\\d 07:30:00"
 },
